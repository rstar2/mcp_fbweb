{
  "name": "@fileflex/mcp",
  "version": "0.0.2",
  "type": "module",
  "description": "A Model Context Protocol (MCP) server that provides AI capabilities for accessing a FileFlex server API",
  "author": "Rumen Neshev <rumenn@qnext.com> (<rstardev@abv.bg>)",
  "keywords": [
    "FileFlex",
    "MCP"
  ],
  "license": "MIT",
  "bin": {
    "mcp": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "start": "node build/index.js",
    "dev": "tsx --env-file=.env.development src/index.ts",
    "prepublishOnly": "pnpm build",
    "publish:beta": "pnpm publish --tag beta",
    "test": "tsx --env-file=.env.test --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "dotenv": "^17.3.1",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
